{
  "description": "Rigor plugin hooks — block direct SQLite access",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-sqlite.sh"
          }
        ]
      }
    ]
  }
}
